name: Build Flet APK

on:
  push:
    branches: [ main ]

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3

    - name: Build APK with Flet
      run: |
        pip install flet
        flet publish gangstar_app.py --platform apk

    - name: Upload APK
      uses: actions/upload-artifact@v3
      with:
        name: gangstar-rio.apk
        path: dist/gangstar_app.apk
